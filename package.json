{
  "name": "@rizakura-hontai/daymark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.tsx",
    "./backup": "./src/backup.ts",
    "./browser": "./src/browser.ts",
    "./contracts": "./src/contracts.ts",
    "./server": {
      "workerd": "./src/server.ts",
      "browser": null,
      "default": "./src/server.ts"
    },
    "./schema": {
      "workerd": "./src/schema.ts",
      "browser": null,
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --project tsconfig.build.json",
    "audit": "pnpm audit --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm audit"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
